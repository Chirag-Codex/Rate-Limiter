# Rate Limiter Backend Environment Configuration

# Port the Node server listens on (Render/Railway will automatically provide PORT)
PORT=5000

# MongoDB connection URI (e.g., MongoDB Atlas connection string)
DB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/rate_limiter_db?retryWrites=true&w=majority

# Node environment: 'development' or 'production'
NODE_ENV=production

# Frontend Client URL allowed for CORS (e.g. https://your-app.vercel.app)
CLIENT_URL=https://rate-limiter-ruddy.vercel.app

# Secret key for JWT signing & verification (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_random_key_here

